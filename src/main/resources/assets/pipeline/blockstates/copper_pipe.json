{
  "multipart": [
    {
      "apply": {
        "model": "pipeline:block/copper_pipe"
      }
    },
    {
      "apply": {
        "model": "pipeline:block/copper_pipe_straight"
      },
      "when": {
        "north": "true"
      }
    },
    {
      "apply": {
        "model": "pipeline:block/copper_pipe_straight_south"
      },
      "when": {
        "south": "true"
      }
    },
    {
      "apply": {
        "model": "pipeline:block/copper_pipe_straight",
        "y": 90
      },
      "when": {
        "east": "true"
      }
    },
    {
      "apply": {
        "model": "pipeline:block/copper_pipe_straight_south",
        "y": 90
      },
      "when": {
        "west": "true"
      }
    },
    {
      "apply": {
        "model": "pipeline:block/copper_pipe_straight_up",
        "y": 90
      },
      "when": {
        "up": "true"
      }
    },
    {
      "apply": {
        "model": "pipeline:block/copper_pipe_straight_down",
        "x": 90
      },
      "when": {
        "down": "true"
      }
    }
  ]
}